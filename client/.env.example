# WebSocket URL of the deployed game server, including the /ws path.
# Required in production — Vite bakes this in at build time, so it must be
# set in your host's dashboard *before* the build runs (not at runtime).
# Use wss:// (secure), since the client is served over HTTPS.
#
# If unset, the client falls back to ws://<current-hostname>:8787/ws, which
# only works for local development against `npm run dev`.
VITE_WS_URL=wss://api.folvra.com/ws
